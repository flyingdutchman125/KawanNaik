  <metadata>
    <name>Gunung Papandayan - via Camp David</name>
    <desc>Rute pendakian resmi Gunung Papandayan via via Camp David</desc>
  </metadata>
  <wpt lat="-7.315" lon="107.742">
    <ele>1065.0</ele>
    <name>Basecamp Camp David</name>
    <desc>Pintu gerbang wisata pendakian ramah keluarga &amp; pemula</desc>
    <type>BASECAMP</type>
  </wpt>
  <wpt lat="-7.32" lon="107.738">
